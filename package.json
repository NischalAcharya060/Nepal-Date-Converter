{
  "name": "@nischalacharya060/nepal-date-converter",
  "version": "1.0.0",
  "description": "Fast, accurate, zero-dependency Nepali (Bikram Sambat / BS) to Gregorian (AD) and AD to BS date converter with Devanagari and English localization.",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "pretest": "npm run build",
    "test": "node --test test/index.test.mjs test/cjs.test.cjs",
    "prepublishOnly": "npm run test",
    "publish:github": "npm publish --registry=https://npm.pkg.github.com"
  },
  "keywords": [
    "nepal",
    "nepali",
    "nepali-date",
    "nepal-date-converter",
    "nepali-calendar",
    "bikram-sambat",
    "bs-to-ad",
    "ad-to-bs",
    "miti",
    "miti-converter",
    "devanagari",
    "date-converter",
    "typescript"
  ],
  "author": "Nischal Acharya <Nischal060@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NischalAcharya060/nepal-date-converter.git"
  },
  "bugs": {
    "url": "https://github.com/NischalAcharya060/nepal-date-converter/issues"
  },
  "homepage": "https://github.com/NischalAcharya060/nepal-date-converter#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
